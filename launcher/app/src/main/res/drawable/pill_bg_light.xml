<?xml version="1.0" encoding="utf-8"?>
<!-- The frosted pill over the light skin: near-white glass, and the dark green rim on focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_rim" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <!-- Reorder button while reorder mode is on (focus is on the tiles then). -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#593E6A47" />
            <stroke android:width="1.5dp" android:color="@color/glass_rim" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#E6FFFFFF" android:endColor="#BFFFFFFF" />
            <stroke android:width="1dp" android:color="#FFFFFFFF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
</selector>
